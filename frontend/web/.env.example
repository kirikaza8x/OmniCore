# Settings of the web server (not exposed to the browser). Copy to .env.local for `npm run dev`.

# Where the gateway is, as seen from this server. Local dev: the compose gateway on the host port.
# Inside Docker compose this is set to http://gateway:80 by docker-compose.web.yml.
API_BASE_URL=http://localhost:8080

# Set to true when the site is served over HTTPS (cookies become Secure).
COOKIE_SECURE=false
