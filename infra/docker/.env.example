# ==========================================
# OmniCore Master Environment Configuration
# ==========================================

# Application Environment
ASPNETCORE_ENVIRONMENT=Development

# Swagger Control (Set to 'false' in production)
ENABLE_SWAGGER=true
COMPOSE_PROFILES=default,dev

# ------------------------------------------
# Gateway & Microservices Ports
# ------------------------------------------
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=5001

# ------------------------------------------
# Swagger UI - Aggregated Service Specs
# ------------------------------------------
# JSON array of {url, name} objects, must stay valid JSON on ONE line.
# "url" is the path served THROUGH the gateway (see nginx /specs/ block),
# not the raw internal service address.
#
# To add a new service:
#   1. Add its spec route to nginx.conf under location /specs/
#   2. Append {"url": "/specs/<name>.json", "name": "<Display Name>"} below
#
# Example with a second "orders" service added (for reference, not active):
# SWAGGER_URLS=[{"url":"/specs/auth.json","name":"Auth Service"},{"url":"/specs/orders.json","name":"Orders Service"}]
SWAGGER_URLS=[{"url":"/specs/auth.json","name":"Auth Service"}]

# ------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------
POSTGRES_USER=omnicore
POSTGRES_PASSWORD=omnicore_password
POSTGRES_DB=omnicore
POSTGRES_PORT=5432

# Database Names per Microservice
AUTH_DB_NAME=omnicore_auth_db
USER_DB_NAME=omnicore_user_db
NOTIFICATION_DB_NAME=omnicore_notification_db

# ------------------------------------------
# Message Broker - RabbitMQ
# ------------------------------------------
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# ------------------------------------------
# Cache - Redis
# ------------------------------------------
REDIS_PORT=6379

# ------------------------------------------
# Object Storage - MinIO
# ------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadminpassword
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=omnicore-bucket

# ------------------------------------------
# Event Streaming - Kafka & Kafka UI
# ------------------------------------------
KAFKA_PORT=9092
KAFKA_UI_PORT=8088

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
JWT_SECRET=YourSuperSecretKeyWithAtLeast32BytesLength!
JWT_ISSUER=OmniCore.Auth
JWT_AUDIENCE=OmniCore.Clients

GOOGLE_AUTH_SERVER_CLIENT_ID=mock-server-client-id.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_ID=mock-client-id.apps.googleusercontent.com