# ==========================================
# OmniCore Master Environment Configuration
# ==========================================
# Copy to .env and replace every CHANGE_ME value. These values are placeholders, never use them as they are.
# Local development: `docker compose up -d --build`
# Server:            `docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build`
#                    (the prod override also needs ALLOWED_HOSTS and CORS_ALLOWED_ORIGIN, see the end of this file)
#
# Passwords go into connection strings: avoid ';' '=' and spaces in them.
# Generate a secret with: openssl rand -base64 36

# Application Environment (the prod override forces Production)
ASPNETCORE_ENVIRONMENT=Development

# Swagger Control (the prod override forces it off)
ENABLE_SWAGGER=true
COMPOSE_PROFILES=default,dev

# ------------------------------------------
# Development-only switches
# ------------------------------------------
# The compose defaults for these are safe (false). They are turned on here for local debugging only.
# Do NOT copy these three lines to a server.
DB_ENABLE_DETAILED_ERRORS=true
DB_ENABLE_SENSITIVE_DATA_LOGGING=true
CORS_ALLOW_ANY_ORIGIN=true

# ------------------------------------------
# Gateway & Microservices Ports
# ------------------------------------------
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=5001
USER_SERVICE_PORT=5002

# ------------------------------------------
# Swagger UI - Aggregated Service Specs
# ------------------------------------------
# JSON array of {url, name} objects, must stay valid JSON on ONE line.
# "url" is the path served THROUGH the gateway (see nginx /specs/ block),
# not the raw internal service address.
#
# To add a new service:
#   1. Add its spec route to nginx.conf under location /specs/
#   2. Append {"url": "/specs/<name>.json", "name": "<Display Name>"} below
SWAGGER_URLS=[{"url":"/specs/auth.json","name":"Auth Service"},{"url":"/specs/user.json","name":"User Service"}]

# ------------------------------------------
# PostgreSQL Database Settings
# ------------------------------------------
POSTGRES_USER=omnicore
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=omnicore
POSTGRES_PORT=5432

# Database Names per Microservice
AUTH_DB_NAME=omnicore_auth_db
USER_DB_NAME=omnicore_user_db
NOTIFICATION_DB_NAME=omnicore_notification_db

# ------------------------------------------
# Message Broker - RabbitMQ
# ------------------------------------------
# Not "guest": RabbitMQ only lets the built-in guest user connect from localhost.
RABBITMQ_DEFAULT_USER=omnicore
RABBITMQ_DEFAULT_PASS=CHANGE_ME
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672

# Provider must be exactly RabbitMQ or Kafka ("Both" is rejected at startup).
# The transactional outbox only works with RabbitMQ.
MESSAGE_BROKER_PROVIDER=RabbitMQ
MESSAGE_BROKER_ENABLE_OUTBOX=true

# ------------------------------------------
# Cache - Redis
# ------------------------------------------
REDIS_PORT=6379
REDIS_PASSWORD=
AUTH_REDIS_INSTANCE_NAME=OmniCore_Auth_
USER_REDIS_INSTANCE_NAME=OmniCore_User_

# ------------------------------------------
# Object Storage - MinIO
# ------------------------------------------
MINIO_ROOT_USER=omnicore
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_NAME=omnicore-bucket

# ------------------------------------------
# Event Streaming - Kafka & Kafka UI
# ------------------------------------------
KAFKA_PORT=9092
KAFKA_UI_PORT=8088

# ------------------------------------------
# Authentication & Security
# ------------------------------------------
# Must be at least 32 characters (checked at startup). The placeholder is long enough to start, but it is public:
# replace it, or anyone can mint valid tokens.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_36
JWT_ISSUER=OmniCore.Auth
JWT_AUDIENCE=OmniCore.Clients

GOOGLE_AUTH_SERVER_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_AUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com

# ------------------------------------------
# Production only (read by docker-compose.prod.yml, which refuses to start without them)
# ------------------------------------------
# Public host name(s) the API answers to, ';' separated if several. Example: api.example.com
ALLOWED_HOSTS=
# Front-end origin allowed by CORS, with scheme. Example: https://app.example.com
CORS_ALLOWED_ORIGIN=
