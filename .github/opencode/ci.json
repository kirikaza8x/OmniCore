{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "external_directory": "deny",
    "bash": {
      "*": "deny",
      "ls*": "allow",
      "cat *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "dotnet restore*": "allow",
      "dotnet build*": "allow",
      "dotnet test*": "allow",
      "npm ci": "allow",
      "npm run lint*": "allow",
      "npm run typecheck*": "allow",
      "npm test*": "allow"
    }
  }
}
