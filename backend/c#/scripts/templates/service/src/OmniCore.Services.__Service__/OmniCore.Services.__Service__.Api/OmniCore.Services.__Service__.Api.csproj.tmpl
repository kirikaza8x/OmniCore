<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\OmniCore.Services.__Service__.Infrastructure\OmniCore.Services.__Service__.Infrastructure.csproj" />
    <ProjectReference Include="..\OmniCore.Services.__Service__.Application\OmniCore.Services.__Service__.Application.csproj" />
    <ProjectReference Include="..\..\OmniCore.Shared\OmniCore.Shared.Api\OmniCore.Shared.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Needed by "dotnet ef" (the startup project must reference the Design package), same as Auth.Api. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
